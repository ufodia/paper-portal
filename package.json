{
  "name": "paper-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Paper on the table. Worlds on the screen.",
  "type": "module",
  "license": "MIT",
  "author": "ufodia",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && npm run build:player && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:player": "node scripts/build-player.mjs",
    "serve:player": "node scripts/serve-player.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "js-aruco2": "2.0.0"
  }
}
